diff -urN -x CVS -x nptl -x nptl_db -x .cvsignore -x '*texi' -x '*manual*' glibc-2.3.2/sysdeps/unix/sysv/linux/ia64/system.c /home/jbailey/Programming/cvstree/libc/sysdeps/unix/sysv/linux/ia64/system.c
--- glibc-2.3.2/sysdeps/unix/sysv/linux/ia64/system.c	1969-12-31 19:00:00.000000000 -0500
+++ /home/jbailey/Programming/cvstree/libc/sysdeps/unix/sysv/linux/ia64/system.c	2003-03-18 16:46:10.000000000 -0500
@@ -0,0 +1,35 @@
+/* Copyright (C) 2002, 2003 Free Software Foundation, Inc.
+   This file is part of the GNU C Library.
