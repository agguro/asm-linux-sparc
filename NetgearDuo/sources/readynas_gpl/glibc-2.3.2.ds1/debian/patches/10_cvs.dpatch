diff -urN -x CVS -x nptl -x nptl_db -x .cvsignore -x '*texi' -x '*manual*' glibc-2.3.2/sysdeps/unix/sysv/linux/powerpc/powerpc32/getcontext.S /home/jbailey/Programming/cvstree/libc/sysdeps/unix/sysv/linux/powerpc/powerpc32/getcontext.S
