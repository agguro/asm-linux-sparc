+++ /home/jbailey/Programming/cvstree/libc/sysdeps/unix/sysv/linux/mips/sysdep.h	1969-12-31 19:00:00.000000000 -0500
@@ -1,282 +0,0 @@
-/* Copyright (C) 2000 Free Software Foundation, Inc.
-   This file is part of the GNU C Library.
-
