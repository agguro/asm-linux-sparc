diff -urN -x CVS -x nptl -x nptl_db -x .cvsignore -x '*texi' -x '*manual*' glibc-2.3.2/sysdeps/generic/semtimedop.c /home/jbailey/Programming/cvstree/libc/sysdeps/generic/semtimedop.c
--- glibc-2.3.2/sysdeps/generic/semtimedop.c	1969-12-31 19:00:00.000000000 -0500
+++ /home/jbailey/Programming/cvstree/libc/sysdeps/generic/semtimedop.c	2003-04-02 18:44:57.000000000 -0500
