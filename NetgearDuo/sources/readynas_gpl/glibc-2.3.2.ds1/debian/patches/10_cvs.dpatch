diff -urN -x CVS -x nptl -x nptl_db -x .cvsignore -x '*texi' -x '*manual*' glibc-2.3.2/sysdeps/unix/sysv/linux/internal_statvfs.c /home/jbailey/Programming/cvstree/libc/sysdeps/unix/sysv/linux/internal_statvfs.c
