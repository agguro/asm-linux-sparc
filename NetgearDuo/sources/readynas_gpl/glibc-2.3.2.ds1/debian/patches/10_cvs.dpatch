+echo $ECHO_N "checking version of $SED... $ECHO_C" >&6
+  ac_prog_version=`$SED --version 2>&1 | sed -n 's/^.*GNU sed version \([0-9]*\.[0-9.]*\).*$/\1/p'`
+  case $ac_prog_version in
