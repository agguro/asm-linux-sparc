diff -urN -x CVS -x nptl -x nptl_db -x .cvsignore -x '*texi' -x '*manual*' glibc-2.3.2/sysdeps/unix/sysv/linux/fatal-prepare.h /home/jbailey/Programming/cvstree/libc/sysdeps/unix/sysv/linux/fatal-prepare.h
--- glibc-2.3.2/sysdeps/unix/sysv/linux/fatal-prepare.h	1969-12-31 19:00:00.000000000 -0500
+++ /home/jbailey/Programming/cvstree/libc/sysdeps/unix/sysv/linux/fatal-prepare.h	2003-04-19 12:53:22.000000000 -0400
@@ -0,0 +1,39 @@
+/* Copyright (C) 2003 Free Software Foundation, Inc.
+   This file is part of the GNU C Library.
+
+   The GNU C Library is free software; you can redistribute it and/or
+   modify it under the terms of the GNU Lesser General Public
+   License as published by the Free Software Foundation; either
