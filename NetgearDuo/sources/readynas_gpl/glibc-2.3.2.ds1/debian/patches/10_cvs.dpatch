+
+#include <errno.h>
+#include <sys/sem.h>
+#include <ipc_priv.h>
+
+#include <sysdep.h>
+#include <sys/syscall.h>
+#include <bp-checks.h>
+
+/* Perform user-defined atomical operation of array of semaphores.  */
+
+int
+semtimedop (semid, sops, nsops, timeout)
+     int semid;
+     struct sembuf *sops;
+     size_t nsops;
+     const struct timespec *timeout;
+{
+  return INLINE_SYSCALL (ipc, 6, IPCOP_semtimedop,
+			 semid, (int) nsops, 0, CHECK_N (sops, nsops),
+			 timeout);
+}
diff -urN -x CVS -x nptl -x nptl_db -x .cvsignore -x '*texi' -x '*manual*' glibc-2.3.2/sysdeps/unix/sysv/linux/setegid.c /home/jbailey/Programming/cvstree/libc/sysdeps/unix/sysv/linux/setegid.c
--- glibc-2.3.2/sysdeps/unix/sysv/linux/setegid.c	2002-08-13 10:29:42.000000000 -0400
+++ /home/jbailey/Programming/cvstree/libc/sysdeps/unix/sysv/linux/setegid.c	2003-08-21 08:37:12.000000000 -0400
