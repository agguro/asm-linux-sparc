+static OFF_T get_size_arg(char *size_arg)
+{ 
+	OFF_T size;
+	char *arg;
+
+	for (arg = size_arg; isdigit(*(uchar*)arg); arg++) {}
+	if (*arg == '.')
+		for (arg++; isdigit(*(uchar*)arg); arg++) {}
+	switch (toupper(*arg)) {
+	case 'K':
+		size = atof(size_arg) * 1024;
+		break;
+	case 'M':
+		size = atof(size_arg) * 1024*1024;
+		break;
+	case 'G':
+		size = atof(size_arg) * 1024*1024*1024;
+		break;
+	case '\0':
+		size = atof(size_arg);
+		break;
+	default:
+		size = 0;
+		break;
+	}
+	return size;
+}
+
