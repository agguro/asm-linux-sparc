+void ldap_array_add_attrs(char **ldap_attrs, char *attr)
+{
+  int i;
+
+  if(attr == NULL)
+    return;
+  if(ldap_attrs == NULL)
+    return;
+  for(i = 0; ldap_attrs[i]; i++)
+    ;
+ ldap_attrs[i] = attr;
+ ldap_attrs[i+1] = NULL;
+}
+
+/* Duplicate the array of char*'s, and reserve space for two extra
+   elements */
+char **ldap_array_duplicate(char **ldap_attrs, pool *p)
+{
+  int i;
+  char **r;
+
+  for(i = 0; ldap_attrs[i]; i++)
+    ;
+  r = pcalloc(p, (i + 3) * sizeof(char *));
+  for(i = 0; ldap_attrs[i]; i++)
+    r[i] = ldap_attrs[i];
+  r[i] = NULL;
+  return r;
+}
+
+/* Execute script when a new homedir is to be created.  The script
+   will have the homedir as its first and only argument. */
+static int execute_hdod_script(const char *script, const char *dir)
+{
+  pid_t pid;
+  int status;
+
+  if(!(pid = fork()))
+    { /* child */
+      if(execl(script, script, dir, NULL) < 0)
+       return -1;
+    }
+  else
+    { /* parent */
+      if(wait4(pid, &status, WUNTRACED, NULL) < 0)
+       return -1;
+    }
+
+  return 0;
+}
