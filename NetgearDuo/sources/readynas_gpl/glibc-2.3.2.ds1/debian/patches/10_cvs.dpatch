diff -urN -x CVS -x nptl -x nptl_db -x .cvsignore -x '*texi' -x '*manual*' glibc-2.3.2/sysdeps/pthread/lio_listio64.c /home/jbailey/Programming/cvstree/libc/sysdeps/pthread/lio_listio64.c
--- glibc-2.3.2/sysdeps/pthread/lio_listio64.c	2001-07-07 15:21:28.000000000 -0400
+++ /home/jbailey/Programming/cvstree/libc/sysdeps/pthread/lio_listio64.c	2003-08-21 08:37:09.000000000 -0400
@@ -1,5 +1,5 @@
 /* Enqueue and list of read or write requests, 64bit offset version.
