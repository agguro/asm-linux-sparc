--- glibc-2.3.2/sysdeps/i386/elf/start.S	2002-12-09 22:41:52.000000000 -0500
+++ /home/jbailey/Programming/cvstree/libc/sysdeps/i386/elf/start.S	2003-06-03 09:36:28.000000000 -0400
@@ -1,5 +1,5 @@
