Architecture: any
Depends: netbase (>= 4.07), ${perl:Depends}, ${shlibs:Depends}, debconf (>= 0.5.00), proftpd|proftpd-mysql|proftpd-pgsql|proftpd-ldap, debianutils (>= 1.16)
Suggests: proftpd-doc
Replaces: proftpd (<< 1.2.8-1), proftpd-mysql (<< 1.2.8-1), proftpd-pgsql (<< 1.2.8-1), proftpd-ldap (<< 1.2.8-1)
