+
+  /* Sanity check. */
+  if (!use_quotas || !use_dirs)
+    return DECLINED(cmd);
+
+  /* Write out an updated quota entry. */
+  QUOTATAB_TALLY_WRITE(-quotatab_disk_bytes, 0, -quotatab_disk_bytes,
+    -1, 0, -1)
+
+  /* Clear the cached bytes. */
+  quotatab_disk_bytes = 0;
+
+  return DECLINED(cmd);
+}
