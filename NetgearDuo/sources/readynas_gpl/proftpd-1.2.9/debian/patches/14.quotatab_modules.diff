+++ proftpd-1.2.9/contrib/mod_quotatab_ldap.c	2003-11-01 21:27:19.000000000 +0100
@@ -0,0 +1,162 @@
+/*
+ * ProFTPD: mod_quotatab_ldap -- a mod_quotatab sub-module for obtaining
+ *                               quota information from an LDAP directory.
+ *
