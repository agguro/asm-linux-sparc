+++ /home/jbailey/Programming/cvstree/libc/sysdeps/ia64/bits/atomic.h	2003-08-21 08:37:09.000000000 -0400
@@ -0,0 +1,126 @@
+/* Copyright (C) 2003 Free Software Foundation, Inc.
+   This file is part of the GNU C Library.
+
