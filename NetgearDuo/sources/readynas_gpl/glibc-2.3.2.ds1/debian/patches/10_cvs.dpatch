+++ /home/jbailey/Programming/cvstree/libc/sysdeps/ia64/dl-fptr.c	1969-12-31 19:00:00.000000000 -0500
@@ -1,288 +0,0 @@
-/* Manage function descriptors.  IA-64 version.
-   Copyright (C) 1999, 2000, 2001, 2002 Free Software Foundation, Inc.
