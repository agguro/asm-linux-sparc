+}
diff -urN -x CVS -x nptl -x nptl_db -x .cvsignore -x '*texi' -x '*manual*' glibc-2.3.2/elf/tst-tls12.c /home/jbailey/Programming/cvstree/libc/elf/tst-tls12.c
