--- glibc-2.3.2/timezone/zic.c	2002-04-05 22:38:45.000000000 -0500
+++ /home/jbailey/Programming/cvstree/libc/timezone/zic.c	2003-08-21 08:37:18.000000000 -0400
@@ -2152,12 +2152,13 @@
 	}
 	if (dayoff < 0 && !TYPE_SIGNED(time_t))
 		return min_time;
+	if (dayoff < min_time / SECSPERDAY)
+		return min_time;
+	if (dayoff > max_time / SECSPERDAY)
+		return max_time;
 	t = (time_t) dayoff * SECSPERDAY;
-	/*
-	** Cheap overflow check.
-	*/
-	if (t / SECSPERDAY != dayoff)
-		return (dayoff > 0) ? max_time : min_time;
+	if (t > 0 && max_time - t < rp->r_tod)
+		return max_time;
 	return tadd(t, rp->r_tod);
 }
 
