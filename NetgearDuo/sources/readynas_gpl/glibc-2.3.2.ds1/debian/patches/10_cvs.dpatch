diff -urN -x CVS -x nptl -x nptl_db -x .cvsignore -x '*texi' -x '*manual*' glibc-2.3.2/sysdeps/unix/sysv/linux/s390/semtimedop.c /home/jbailey/Programming/cvstree/libc/sysdeps/unix/sysv/linux/s390/semtimedop.c
--- glibc-2.3.2/sysdeps/unix/sysv/linux/s390/semtimedop.c	1969-12-31 19:00:00.000000000 -0500
+++ /home/jbailey/Programming/cvstree/libc/sysdeps/unix/sysv/linux/s390/semtimedop.c	2003-08-21 08:37:17.000000000 -0400
