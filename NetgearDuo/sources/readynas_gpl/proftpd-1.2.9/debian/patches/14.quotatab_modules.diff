+
+  CHECK_ARGS(cmd, 1);
+  CHECK_CONF(cmd, CONF_ROOT|CONF_VIRTUAL|CONF_GLOBAL);
+
+  if (strcasecmp(cmd->argv[1], "b") == 0) {
+    /* No need to assign to the units variable, as it defaults to
+     * displaying bytes
+     */
+    ;
