--- glibc-2.3.2/locale/programs/locfile.c	2003-01-13 03:55:06.000000000 -0500
+++ /home/jbailey/Programming/cvstree/libc/locale/programs/locfile.c	2003-08-21 08:37:05.000000000 -0400
