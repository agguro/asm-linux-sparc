+/* Check any allow/deny IP address ranges to see if this user is
+   allowed to connect.  This function uses the result of
+   ldap_lookup_user(), so it can only be called after the USER command
+   has been handled completely.
+*/
+int ldap_check_ip_match(cmd_rec *cmd, const char *name)
+{
+  char *arg;
+  int argc;
+  int negate = 0;
+  array_header *res;
+
+  if(strcasecmp(name, "Allow") == 0) {
+    res = ldap_check_allow_result;
+  } else {
+    res = ldap_check_deny_result;
+  }
+
+  if(res != (array_header*)(NULL)) {
+    for(argc = 0; (arg = (char*)((char**)res->elts)[argc]) && argc < res->nelts; argc++) {
+      if(*arg == '!') {
+       negate++;
+       arg++;
+      } else negate = 0;
+
+      /* match_ip() is in dirtree.c */
+      switch(match_ip(session.c->remote_addr,session.c->remote_name,arg)) {
+      case 1:
+       /* If in logical negate mode, we specifically did NOT find what we
+        * were looking for.
+        */
+       if(negate) break;
+
+       /* otherwise, we did */
+       return TRUE;
+
+      case -1:
+       /* -1 is only returned on an explicit mismatch, which can only
+        * happen for "NONE".  Negate is not valid in this case, and is
+        * disallowed by mod_core's _add_allow_deny().
+        */
+       return FALSE;
+
+      default:
+       /* No match, but if we are in negate mode, that means it IS
+        * a match.
+        */
+       if(negate) return FALSE;
+       break;
+      }
+    }
+  }
+  return FALSE;
+}
+
+
+/* When we get a PASS command, first check if the user is allowed to
+   log in; check with any allow/deny values that we acquired from LDAP
+   earlier.
+   The user must exist in the LDAP directory.
+*/
+MODRET ldap_cmd_pass(cmd_rec *cmd)
+{
+  if(ldap_check_allow)
+    /* Check allow rules */
+    if(ldap_check_ip_match(cmd, "Allow") == TRUE)
+      return DECLINED(cmd);  /* No change, continue the command chain */
+
+  if(ldap_check_deny)
+    /* Check deny rules */
+    if(ldap_check_ip_match(cmd, "Deny") == TRUE)
+      {
+       log_pri(LOG_NOTICE, "User denied access based on the value of %s\n",
+               ldap_check_deny);
+       /* User is not allowed to log in, based on his IP address. */
+       return ERROR_MSG(cmd,R_530,"Login incorrect.");
+      }
+
+  return DECLINED(cmd);  /* No change, continue the command chain */
+}
