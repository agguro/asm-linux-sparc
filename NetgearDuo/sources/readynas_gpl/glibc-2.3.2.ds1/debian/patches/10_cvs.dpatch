--- glibc-2.3.2/sysdeps/mips/memcpy.S	2002-09-10 07:22:59.000000000 -0400
+++ /home/jbailey/Programming/cvstree/libc/sysdeps/mips/memcpy.S	2003-05-12 12:13:07.000000000 -0400
